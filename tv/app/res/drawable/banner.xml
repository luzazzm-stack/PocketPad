<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 TV home-row banner: the phone app's d-pad icon on the PC window's ground colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#16161E" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground"
        android:width="180dp" android:height="180dp" android:gravity="center" />
</layer-list>
