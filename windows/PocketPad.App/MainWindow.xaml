<Window x:Class="PocketPad.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PocketPad for PC"
        Width="720" Height="430"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Ground}"
        Foreground="{StaticResource Ink}"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="CanMinimize">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="1"
                            ResizeBorderThickness="4"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= title bar ================= -->
        <Border Grid.Row="0" Background="{StaticResource ChromeBar}"
                BorderBrush="{StaticResource Rule}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <Image Source="pocketpad.ico" Width="18" Height="18" Margin="14,0,9,0"
                       VerticalAlignment="Center"/>
                <TextBlock Text="PocketPad for PC" VerticalAlignment="Center"
                           FontSize="12.5" Foreground="{StaticResource InkSoft}"/>
                <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="✕"
                        Style="{StaticResource CaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnCloseToTray"/>
                <Button x:Name="BtnMin" DockPanel.Dock="Right" Content="—"
                        Style="{StaticResource CaptionButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnMinimize"/>
                <Button x:Name="BtnHelp" DockPanel.Dock="Right" Content="?"
                        Style="{StaticResource CaptionButton}" FontWeight="Bold"
                        ToolTip="How to use PocketPad"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnHelp"/>
            </DockPanel>
        </Border>

        <!-- ================= STATE: WAITING ================= -->
        <Grid Grid.Row="1" x:Name="WaitingView">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="252"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="30,26,24,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Ellipse x:Name="PulseDot" Width="9" Height="9" Fill="#E0AF68"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="Waiting for your phone…" Margin="9,0,0,0" FontSize="13"
                               Foreground="{StaticResource InkSoft}" VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Text="PC ADDRESS" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,16">
                    <TextBlock x:Name="AddrText" Text="—" FontFamily="{StaticResource Mono}"
                               FontSize="30" FontWeight="Bold" Foreground="{StaticResource AddrColor}"/>
                    <Button Content="copy" Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                            VerticalAlignment="Center" Click="OnCopyAddr"/>
                </StackPanel>

                <TextBlock Text="CODE" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock x:Name="CodeText" Text="—" FontFamily="{StaticResource Mono}"
                               FontSize="30" FontWeight="Bold" Foreground="{StaticResource CodeColor}"/>
                    <Button Content="copy" Style="{StaticResource GhostButton}" Margin="12,0,0,0"
                            VerticalAlignment="Center" Click="OnCopyCode"/>
                </StackPanel>

                <Border Background="{StaticResource PanelSoft}" CornerRadius="10"
                        Padding="15,11" Margin="0,24,0,0">
                    <TextBlock FontSize="12.5" Foreground="{StaticResource InkSoft}"
                               TextWrapping="Wrap" LineHeight="21">
                        <Run FontWeight="Bold" Foreground="{StaticResource Ink}">1.</Run>
                        <Run>Open</Run>
                        <Run FontWeight="Bold" Foreground="{StaticResource Ink}">PocketPad</Run>
                        <Run>on your phone</Run>
                        <Run Foreground="{StaticResource InkFaint}">·</Run>
                        <Run FontWeight="Bold" Foreground="{StaticResource Ink}">2.</Run>
                        <Run>Scan the QR — or type these two values</Run>
                        <Run Foreground="{StaticResource InkFaint}">·</Run>
                        <Run FontWeight="Bold" Foreground="{StaticResource Ink}">3.</Run>
                        <Run>Play</Run>
                    </TextBlock>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Background="White" CornerRadius="12" Padding="11" Width="180" Height="180">
                        <Image x:Name="QrImage" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <TextBlock Margin="0,12,0,0" TextAlignment="Center" FontSize="12"
                               Foreground="{StaticResource InkFaint}" LineHeight="18">
                        <Run FontWeight="SemiBold" Foreground="{StaticResource InkSoft}">Scan with PocketPad</Run>
                        <LineBreak/><Run>no typing needed</Run>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= STATE: CONNECTED ================= -->
        <Grid Grid.Row="1" x:Name="ConnectedView" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="30,24,24,20">
                <Border Background="{StaticResource GoodDim}" BorderBrush="#4F6A38"
                        BorderThickness="1" CornerRadius="10" Padding="13,10" Margin="0,0,0,20">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Background="{StaticResource Good}"
                                CornerRadius="8" Width="34" Height="34" Margin="0,0,12,0">
                            <TextBlock Text="✓" FontWeight="Bold" FontSize="16" Foreground="#16161E"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PhoneName" Text="Phone connected" FontSize="14"
                                       FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Text="Start your game — each phone shows up as an Xbox controller"
                                       FontSize="11.5" Foreground="{StaticResource InkSoft}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <StackPanel x:Name="PhonesList" Margin="2,0,0,14"/>

                <TextBlock Text="DELAY RIGHT NOW" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock x:Name="MsText" Text="—" FontFamily="{StaticResource Mono}"
                               FontSize="52" FontWeight="Bold" Foreground="{StaticResource Good}"/>
                    <TextBlock x:Name="MsQual" Text=" ms" FontFamily="{StaticResource Mono}"
                               FontSize="15" Foreground="{StaticResource InkFaint}"
                               VerticalAlignment="Bottom" Margin="6,0,0,10"/>
                </StackPanel>

                <Canvas x:Name="SparkCanvas" Width="260" Height="36" HorizontalAlignment="Left"
                        Margin="0,0,0,14" ClipToBounds="True">
                    <Polyline x:Name="SparkLine" Stroke="{StaticResource Good}" StrokeThickness="2"
                              StrokeLineJoin="Round"/>
                </Canvas>

                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,28,0">
                        <TextBlock x:Name="StatInputs" Text="0" FontFamily="{StaticResource Mono}"
                                   FontSize="16" FontWeight="Bold" Foreground="{StaticResource InkSoft}"/>
                        <TextBlock Text="inputs this session" FontSize="11.5"
                                   Foreground="{StaticResource InkFaint}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="StatTime" Text="0 min" FontFamily="{StaticResource Mono}"
                                   FontSize="16" FontWeight="Bold" Foreground="{StaticResource InkSoft}"/>
                        <TextBlock Text="connected" FontSize="11.5"
                                   Foreground="{StaticResource InkFaint}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Rule}" BorderThickness="1,0,0,0">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border x:Name="AddPhonePanel" Background="White" CornerRadius="9"
                            Padding="7" Width="110" Height="110" HorizontalAlignment="Center">
                        <Image x:Name="QrImageSmall" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                    <TextBlock x:Name="AddPhoneCaption" Margin="0,8,0,0" TextAlignment="Center"
                               FontSize="11" Foreground="{StaticResource InkFaint}"
                               Text="Add another phone — scan&#10;(up to 4 players)"/>
                    <Button Content="Disconnect phones" Style="{StaticResource DangerButton}"
                            Margin="0,18,0,0" HorizontalAlignment="Center"
                            Click="OnDisconnectPhone"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= STATE: DRIVER MISSING ================= -->
        <StackPanel Grid.Row="1" x:Name="DriverView" Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
            <TextBlock Text="One-time setup needed" FontSize="21" FontWeight="Bold"
                       Foreground="{StaticResource Ink}" TextAlignment="Center"/>
            <TextBlock Margin="0,10,0,20" FontSize="13.5" Foreground="{StaticResource InkSoft}"
                       TextWrapping="Wrap" TextAlignment="Center" LineHeight="22"
                       Text="PocketPad needs a small free Windows add-on (the ViGEm controller driver) to create the virtual controller. Install it, then press Try again."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Get the driver" Style="{StaticResource AccentButton}"
                        Click="OnGetDriver" Margin="0,0,10,0"/>
                <Button Content="Try again" Style="{StaticResource GhostButton}"
                        FontSize="13" Padding="16,8" Click="OnRetryDriver"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
